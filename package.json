{
  "name": "farmstead",
  "version": "0.1.0",
  "private": true,
  "description": "Farmstead \u2014 a top-down farming RPG (browser, no build step).",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/playthrough.mjs",
    "test:touch": "node tests/e2e/touch.mjs",
    "test:clearing": "node tests/e2e/clearing.mjs && node tests/e2e/building_after_clearing.mjs",
    "test:village": "node tests/e2e/village.mjs",
    "test:progression": "node tests/e2e/progression.mjs",
    "test:vehicles": "node tests/e2e/vehicles.mjs",
    "test:integration": "node tests/e2e/integration.mjs",
    "test:polish": "node tests/e2e/polish.mjs",
    "test:sprinklers": "node tests/e2e/sprinklers.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
